# docker/claude.env - how Claude Code in the claude container signs in and which model it uses.
# Copy to docker/claude.env (git-ignored; chmod 600) and keep ONE of the sections below.
# Without this file, sign in once in the web terminal instead (saved in data/claude-home).
# After changing it:  docker compose up -d   (recreates the container; a plain restart keeps the old values)
#
# A line with just a NAME (no =) passes that variable through from the shell you run docker compose in,
# so the value doesn't have to be written in this file:
#     ANTHROPIC_API_KEY
# A line NAME=value sets it here.

# --- 1. Anthropic API key (Claude Console) ----------------------------------------------------------------
#ANTHROPIC_API_KEY=sk-ant-...

# --- 2. Claude subscription (Pro / Max / Team / Enterprise), long-lived token from `claude setup-token` -------
#CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# --- 3. Amazon Bedrock ----------------------------------------------------------------------------------------
#CLAUDE_CODE_USE_BEDROCK=1
#AWS_REGION=us-east-1
# either access keys ...
#AWS_ACCESS_KEY_ID=...
#AWS_SECRET_ACCESS_KEY=...
#AWS_SESSION_TOKEN=...
# ... or a Bedrock API key ...
#AWS_BEARER_TOKEN_BEDROCK=...
# ... or a profile from a mounted ~/.aws (see the volumes example in compose.yaml)
#AWS_PROFILE=bedrock

# --- 4. Google Vertex AI --------------------------------------------------------------------------------------
#CLAUDE_CODE_USE_VERTEX=1
#CLOUD_ML_REGION=us-east5
#ANTHROPIC_VERTEX_PROJECT_ID=my-gcp-project
#GOOGLE_APPLICATION_CREDENTIALS=/home/claude/gcp-key.json   # a file in data/claude-home, or a mounted file

# --- 5. An LLM gateway / proxy in front of the API -----------------------------------------------------------
#ANTHROPIC_BASE_URL=https://llm-gateway.example.com
#ANTHROPIC_AUTH_TOKEN=...                 # sent as "Authorization: Bearer ..."
#ANTHROPIC_CUSTOM_HEADERS=X-Team: dev

# --- Optional, with any of the above --------------------------------------------------------------------------
#ANTHROPIC_MODEL=...                      # the model to use (a model name or alias)
#HTTPS_PROXY=http://proxy.example.com:3128
#NO_PROXY=board,localhost,127.0.0.1       # keep 'board' here if you set a proxy
#NODE_EXTRA_CA_CERTS=/home/claude/corp-ca.pem
#DISABLE_TELEMETRY=1
