# docker/.env - settings for docker compose. Copy to docker/.env (git-ignored) and edit.
# Several projects on one machine: one copy of the repo (or one docker/ folder) per project,
# each with its own .env: a different ENV_NAME, BOARD_PORT and TERMINAL_PORT.

ENV_NAME=main                       # names the containers: qaboard-main-board-1, qaboard-main-claude-1
BOARD_KEY=change-me-to-a-long-random-string   # python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
BOARD_NAME=My Project
BOARD_ACCENT=#4f46e5
BOARD_PORT=8787                     # on this machine's 127.0.0.1
MAX_DOC_MB=50                       # up to 60: 512m is enough; above that set BOARD_MEMORY=1g
#BOARD_MEMORY=512m
#BRAND_DIR=../brand/example

PROJECT_DIR=/home/me/projects/my-project      # mounted into the Claude container at /workspace
DEV_WHO=dev-claude
TERMINAL_PORT=7681                  # the web terminal, on this machine's 127.0.0.1
#TERMINAL_TITLE=claude my-project
#TTYD_CREDENTIAL=user:password      # ask for a login before showing the terminal
#CLAUDE_ARGS=--dangerously-skip-permissions
#WITH_CHROMIUM=1                    # add a headless browser to the image (rebuild)

WATCH=1                             # the board watcher: deliver board messages to Claude
WATCH_POLL=5
WATCH_IDLE=20
WATCH_PROMPT_CHECK=1
WATCH_LIVE=1                        # stream the console to the board's Live tab

# Files in the mounted folders are created as this user (match your own: id -u / id -g)
UID=1000
GID=1000
TZ=UTC
