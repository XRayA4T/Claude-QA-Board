# server.env - how this computer reaches the development server.
# Copy to config/server.env and edit. config/server.env is git-ignored.
#
# Everything on the server runs as ONE ordinary account (no sudo needed once Docker, tmux and cron
# are installed). That account must be in the 'docker' group.

# SSH login for that account, and the key to use (a key without a passphrase prompt, or one loaded in
# ssh-agent, so the tunnel can reconnect unattended).
SSH_TARGET="claude@dev.example.com"
SSH_KEY="$HOME/.ssh/id_ed25519"

# Optional: when this computer is on the same LAN as the server, connect straight to its LAN address
# instead of the public name. LAN_PREFIX is a regex matched against this computer's IPv4 addresses.
LAN_HOST=""                 # e.g. 10.0.0.20
LAN_PREFIX=""               # e.g. '10\.0\.0\.'

# Where the boards, web terminals and watchers are installed on the server. Empty = ~/qaboard.
REMOTE_BASE=""

# How a Docker container on the server reaches ports on the server itself (the default bridge
# gateway). Used when Claude Code runs inside a container (CLAUDE_IN_CONTAINER=1 in an env file).
DOCKER_GATEWAY="172.17.0.1"

# The name this computer's Claude Desktop uses on the boards (shown as the author of its posts).
DESKTOP_WHO="me-claude"
