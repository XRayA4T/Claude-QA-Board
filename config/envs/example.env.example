# envs/<name>.env - one development environment: a project on the server, its own QA board,
# its own Claude Code web terminal and its own board watcher.
# Copy to config/envs/<name>.env (e.g. config/envs/webapp.env) and edit; the file name (without
# .env) is the environment name you pass to the scripts: --env webapp.
# You can have as many environments as you like; give each its own ports.

# ---- the board ---------------------------------------------------------------------------------
BOARD_NAME="Example Project"     # shown on the page and in the browser tab
BOARD_ACCENT="#4f46e5"           # main colour (#rrggbb)
BOARD_PORT=8787                  # port on the server
BOARD_LOCAL_PORT=18787           # port on your computer, through the SSH tunnel
MAX_DOC_MB=50                    # largest document the store accepts
BRAND_DIR="brand/example"        # optional look: a folder with brand.css (+ fonts / logo), relative
                                 # to the repo; empty = the plain look
# The board key (shared secret) lives in config/keys/<name>.key - made on the first deploy.

# ---- the project and its Claude Code -------------------------------------------------------------
PROJECT_DIR="/home/claude/projects/example"   # the project folder on the server
CLAUDE_CMD="claude"              # what the web terminal starts in PROJECT_DIR (any command that runs
                                 # Claude Code, e.g. a script that starts it in a container)
DEV_WHO="dev-claude"             # the name this Claude Code uses on the board
# If Claude Code runs inside a Docker container on the server, set CLAUDE_IN_CONTAINER=1: it then
# reaches the board through DOCKER_GATEWAY (server.env) instead of 127.0.0.1.
CLAUDE_IN_CONTAINER=0
# The claude.json file that Claude Code uses, as a path on the server (inside a container this is
# whatever folder is mounted as its home / CLAUDE_CONFIG_DIR), and the project path as Claude Code
# sees it (the same as PROJECT_DIR unless the container mounts it elsewhere).
CLAUDE_JSON=""                   # empty = ~/.claude.json of the server account
CLAUDE_PROJECT_PATH=""           # empty = PROJECT_DIR

# ---- the web terminal (ttyd + tmux, bound to the server's 127.0.0.1 only) ----------------------
TERMINAL_PORT=7681               # port on the server (loopback only)
TERMINAL_LOCAL_PORT=17681        # port on your computer, through the SSH tunnel
TERMINAL_BG="#1b1530"            # colours of the terminal
TERMINAL_FG="#ece8f5"
TERMINAL_BAR_BG="#2f2650"        # tmux status bar
TERMINAL_BAR_FG="#d6cdf0"
TERMINAL_CURSOR="#a99cf0"

# ---- the board watcher -----------------------------------------------------------------------------
WATCH_POLL=5                     # seconds between board checks (no tokens used)
WATCH_IDLE=20                    # Claude must have been idle this long before it is prompted
WATCH_PROMPT_CHECK=1             # 1 = never type while a permission/question prompt is on screen
WATCH_LIVE=1                     # 1 = stream the console to the board's Live tab (read-only)

# ---- extra ports to carry through the SSH tunnel ------------------------------------------------
# "local:remote:description" separated by spaces, e.g. the app you are developing:
EXTRA_FORWARDS="13000:3000:web-app"
